<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pick the server line with -p:JellyfinTarget=10.11 (default: 12). -->
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">12</JellyfinTarget>
    <TargetFramework Condition="'$(JellyfinTarget)' == '12'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinTarget)' == '10.11'">net9.0</TargetFramework>
    <JellyfinPackageVersion Condition="'$(JellyfinTarget)' == '12'">12.1.*</JellyfinPackageVersion>
    <JellyfinPackageVersion Condition="'$(JellyfinTarget)' == '10.11'">10.11.0</JellyfinPackageVersion>
    <!-- The SkiaSharp each server ships: compiled against, never copied. -->
    <SkiaSharpVersion Condition="'$(JellyfinTarget)' == '12'">3.119.4</SkiaSharpVersion>
    <SkiaSharpVersion Condition="'$(JellyfinTarget)' == '10.11'">3.116.1</SkiaSharpVersion>
    <DefineConstants Condition="'$(JellyfinTarget)' == '10.11'">$(DefineConstants);JELLYFIN_10_11</DefineConstants>
    <RootNamespace>Jellyfin.Plugin.SeasonalPicks</RootNamespace>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackageVersion)" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)" />
    <!-- Provided by the server at runtime; compile against it only. -->
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.SeasonalPicks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Web\forYou.js" />
    <EmbeddedResource Include="Web\forYou.js" />
    <!-- Shown on the settings page under "What's new". -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Jellyfin.Plugin.SeasonalPicks.CHANGELOG.md" />
    <!-- Noto Sans Bold (Jellyfin's own UI font), SIL Open Font License: Fonts\OFL.txt. -->
    <EmbeddedResource Include="Fonts\NotoSans-Bold.ttf" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
